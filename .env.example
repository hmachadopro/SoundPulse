# Spotify API — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AWS — préférer un profil AWS CLI ou des rôles IAM plutôt que des clés statiques.
# Ces variables sont un fallback pour le développement local uniquement.
AWS_REGION=eu-west-3
S3_BUCKET_NAME=soundpulse-datalake-changeme

# Airflow (local Docker uniquement)
AIRFLOW_UID=50000
